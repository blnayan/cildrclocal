{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "1440px",
			"wideSize": "100%"
		},
		"color": {
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "background",
					"slug": "background"
				},
				{
					"color": "#1A1A1A",
					"name": "Foreground",
					"slug": "foreground"
				},
				{
					"color": "#6B7280",
					"name": "Muted Foreground",
					"slug": "muted-foreground"
				},
				{
					"color": "#005D40",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#FEF5ED",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#F5F7FA",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#F59E0B",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#FBFAF3",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "color-mix(in srgb, currentColor 20%, transparent)",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"fluid": false,
					"name": "XS",
					"slug": "xs",
					"size": "0.75rem"
				},
				{
					"fluid": false,
					"name": "SM",
					"slug": "sm",
					"size": "0.875rem"
				},
				{
					"fluid": false,
					"name": "Base",
					"slug": "base",
					"size": "1rem"
				},
				{
					"fluid": false,
					"name": "LG",
					"slug": "lg",
					"size": "1.125rem"
				},
				{
					"fluid": false,
					"name": "XL",
					"slug": "xl",
					"size": "1.25rem"
				},
				{
					"fluid": false,
					"name": "2XL",
					"slug": "2xl",
					"size": "1.5rem"
				},
				{
					"fluid": false,
					"name": "3XL",
					"slug": "3xl",
					"size": "1.875rem"
				},
				{
					"fluid": {
						"min": "1.875rem",
						"max": "2.25rem"
					},
					"name": "4XL",
					"slug": "4xl",
					"size": "2.25rem"
				},
				{
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					},
					"name": "5XL",
					"slug": "5xl",
					"size": "3rem"
				},
				{
					"fluid": {
						"min": "3rem",
						"max": "3.75rem"
					},
					"name": "6XL",
					"slug": "6xl",
					"size": "3.75rem"
				},
				{
					"fluid": {
						"min": "3.75rem",
						"max": "4.5rem"
					},
					"name": "7XL",
					"slug": "7xl",
					"size": "4.5rem"
				},
				{
					"fluid": {
						"min": "4.5rem",
						"max": "6rem"
					},
					"name": "8XL",
					"slug": "8xl",
					"size": "6rem"
				},
				{
					"fluid": {
						"min": "6rem",
						"max": "8rem"
					},
					"name": "9XL",
					"slug": "9xl",
					"size": "8rem"
				}
			],
			"fontFamilies": [
				{
					"name": "Geist",
					"slug": "geist",
					"fontFamily": "Geist, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/geist/Geist[wght].woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontFamily": "Geist"
						},
						{
							"src": [
								"file:./assets/fonts/geist/Geist-Italic[wght].woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontFamily": "Geist"
						}
					]
				},
				{
					"name": "Geist Mono",
					"slug": "geist-mono",
					"fontFamily": "\"Geist Mono\", monospace",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/geist-mono/GeistMono[wght].woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontFamily": "\"Geist Mono\""
						},
						{
							"src": [
								"file:./assets/fonts/geist-mono/GeistMono-Italic[wght].woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontFamily": "\"Geist Mono\""
						}
					]
				}
			]
		}
	},
	"styles": {
		"css": ".has-global-padding {padding: 0;}",
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|foreground"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|geist"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|background"
				}

			}
		}
	}
}